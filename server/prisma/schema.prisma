// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(100)
  email        String?  @unique
  phone        String?  @unique
  passwordHash String   @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  bio          String?  @db.Text
  lastSeen     DateTime @default(now()) @map("last_seen")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  ownedGroups      Group[]        @relation("OwnedGroups")
  groups           GroupMember[]
  settings         UserSettings?
  favoritedBy      Favorite[]     @relation("UserFavorites")
  favorites        Favorite[]     @relation("FavoritedByUser")
  hiddenContacts   HiddenContact[] @relation("HidingUser")
  hiddenByUsers    HiddenContact[] @relation("HiddenByUser")
  groupFavorites   GroupFavorite[]

  @@map("users")
}

model Favorite {
  userId     String @map("user_id") @db.Uuid
  favoriteId String @map("favorite_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user     User @relation("FavoritedByUser", fields: [userId], references: [id], onDelete: Cascade)
  favorite User @relation("UserFavorites", fields: [favoriteId], references: [id], onDelete: Cascade)

  @@id([userId, favoriteId])
  @@map("user_favorites")
}

model Message {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  receiverId String?  @map("receiver_id") @db.Uuid
  groupId    String?  @map("group_id") @db.Uuid
  content    String   @db.Text
  type       String   @default("text") @db.VarChar(10)
  readAt     DateTime? @map("read_at")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User?  @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  group    Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId, createdAt(sort: Desc)], name: "idx_messages_dm")
  @@index([groupId, createdAt(sort: Desc)], name: "idx_messages_group")
  @@map("messages")
}

model Group {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  avatarUrl   String?  @map("avatar_url")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  owner       User            @relation("OwnedGroups", fields: [createdBy], references: [id])
  members     GroupMember[]
  messages    Message[]
  favoritedBy GroupFavorite[]

  @@map("groups")
}

model GroupFavorite {
  userId    String   @map("user_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@map("group_favorites")
}

model GroupMember {
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     String   @default("member") @db.VarChar(10)
  joinedAt DateTime @default(now()) @map("joined_at")

  // Relations
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@map("group_members")
}

model HiddenContact {
  hiderId   String   @map("hider_id") @db.Uuid
  hiddenId  String   @map("hidden_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  hider  User @relation("HidingUser", fields: [hiderId], references: [id], onDelete: Cascade)
  hidden User @relation("HiddenByUser", fields: [hiddenId], references: [id], onDelete: Cascade)

  @@id([hiderId, hiddenId])
  @@map("hidden_contacts")
}

model UserSettings {
  userId                  String   @id @map("user_id") @db.Uuid
  lastSeenVisibility      String   @default("everyone") @map("last_seen_visibility") @db.VarChar(10)
  onlineVisibility        String   @default("everyone") @map("online_visibility") @db.VarChar(10)
  readReceiptsEnabled     Boolean  @default(true) @map("read_receipts_enabled")
  typingIndicatorsEnabled Boolean  @default(true) @map("typing_indicators_enabled")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @default(now()) @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}
